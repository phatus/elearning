# PostgreSQL Database URL for Prisma
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/elearning_db?schema=public"

# Direct URL for Prisma migrations/pushes (same as DATABASE_URL unless using connection poolers like PgBouncer)
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/elearning_db?schema=public"

# (Optional) External WebMadrasah Database URL
WEBMADRASAH_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/webmadrasah?schema=public"

# Secret key for webhooks
WEBHOOK_SECRET="change-this-to-a-secure-random-secret"

# Environment
NODE_ENV="production"
PORT=3002
